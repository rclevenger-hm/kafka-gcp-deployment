global:
  scrape_interval: 15s
  evaluation_interval: 30s
rule_files:
  - /etc/prometheus/alerts.yml
scrape_configs:
  - job_name: kafka
    file_sd_configs:
      - files: [/etc/prometheus/kafka-targets.json]
    scrape_timeout: 10s
# Point alerting.alertmanagers at your existing private Alertmanager.
# Generate targets: terraform -chdir=terraform output -json prometheus_targets
